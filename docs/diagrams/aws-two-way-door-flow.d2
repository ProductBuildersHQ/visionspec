# AWS Working Backwards - Two-Way Door Flow (PR/FAQ Start)
# Layout: ELK

direction: down

title: {
  label: AWS Working Backwards - Two-Way Door
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
}

# Vision Phase (Working Backwards) - the founding artifacts
press: {
  label: Press Release\n(Founding Artifact)
  shape: rectangle
  style.fill: "#e8f5e9"
  style.stroke: "#2e7d32"
}

faq: {
  label: FAQ\n(Challenge Assumptions)
  shape: rectangle
  style.fill: "#e3f2fd"
  style.stroke: "#1565c0"
}

# Discovery Phase (optional post-FAQ deepening — the door sets the ceremony;
# the scale picks the tool: OpportunitySpec at feature scale, MRD at product scale)
opportunity-spec: {
  label: OpportunitySpec\n(12-Box Canvas)
  shape: rectangle
  style.fill: "#e3f2fd"
  style.stroke: "#1565c0"
  style.stroke-dash: 3
}

mrd: {
  label: MRD\n(Market Validation)
  shape: rectangle
  style.fill: "#e3f2fd"
  style.stroke: "#1565c0"
  style.stroke-dash: 3
}

# Requirements Phase
prd: {
  label: PRD\n(Product Requirements)
  shape: rectangle
  style.fill: "#fff3e0"
  style.stroke: "#ef6c00"
}

# Experience Phase
uxd: {
  label: UXD\n(User Experience)
  shape: rectangle
  style.fill: "#e8f5e9"
  style.stroke: "#2e7d32"
}

# Technical Phase
trd: {
  label: TRD\n(Technical Design)
  shape: rectangle
  style.fill: "#e3f2fd"
  style.stroke: "#1565c0"
}

tpd: {
  label: TPD\n(Test Plan)
  shape: rectangle
  style.fill: "#e3f2fd"
  style.stroke: "#1565c0"
}

# Flow - Working Backwards: the human-authored PR is the origin
press -> faq: synthesize

# The PR/FAQ iterates through many drafts - iteration is the method
faq -> press: iterate (many drafts) {
  style.stroke-dash: 3
}

# Optional deepening of the FAQ's answers (either tool, per scale)
press -> opportunity-spec
faq -> opportunity-spec: synthesize
press -> mrd
faq -> mrd: synthesize

# Requirements derived from the announced experience, grounded in whichever
# optional deepening is present
press -> prd
faq -> prd: synthesize
opportunity-spec -> prd
mrd -> prd

# Technical synthesis
uxd -> trd
prd -> trd: synthesize

# Test plan synthesis
prd -> tpd
trd -> tpd: synthesize
uxd -> tpd

# Legend
legend: {
  label: Legend
  near: bottom-center
  grid-columns: 3

  human: {
    label: Human-Authored
    shape: rectangle
    style.fill: "#e8f5e9"
    style.stroke: "#2e7d32"
  }

  synth: {
    label: Synthesized
    shape: rectangle
    style.fill: "#e3f2fd"
    style.stroke: "#1565c0"
  }

  hybrid: {
    label: Hybrid
    shape: rectangle
    style.fill: "#fff3e0"
    style.stroke: "#ef6c00"
  }
}
